# ============================================================
# Search
# ============================================================
TAVILY_API_KEY=

# ============================================================
# Which provider runs the agent
# ============================================================
# Two kinds of provider:
#
#   1. "openai_compatible" — any gateway speaking the OpenAI wire format.
#      Set BASE_URL and API_KEY. Works for OpenCode Zen, Together,
#      OpenRouter, vLLM, LM Studio, or a local proxy.
#
#   2. A named provider with its own SDK — groq, anthropic, together,
#      google_genai, ollama, fireworks, mistralai. BASE_URL is ignored;
#      credentials come from that SDK's own variable (GROQ_API_KEY,
#      ANTHROPIC_API_KEY, TOGETHER_API_KEY, ...).
#
LLM_PROVIDER=openai_compatible

# ------------------------------------------------------------
# Option A — OpenCode Zen free tier (OpenAI-compatible)
#   Docs: https://opencode.ai/docs/zen/   Key: https://opencode.ai/auth
#   Confirm the exact model id against the Zen model list before running;
#   a wrong id fails as a 404, not as a helpful error.
# ------------------------------------------------------------
BASE_URL=https://opencode.ai/zen/v1
API_KEY=
QUERY_GENERATOR_MODEL=deepseek-v4-flash
WEB_RESEARCH_MODEL=deepseek-v4-flash
REFLECTION_MODEL=deepseek-v4-flash
ANSWER_MODEL=deepseek-v4-flash

# ------------------------------------------------------------
# Option B — Together, through the same OpenAI-compatible path
#   LLM_PROVIDER=openai_compatible
#   BASE_URL=https://api.together.xyz/v1
#   API_KEY=<together key>
#   ANSWER_MODEL=deepseek-ai/DeepSeek-V3
#
# Option C — Together, through its own SDK
#   LLM_PROVIDER=together
#   TOGETHER_API_KEY=<together key>
#   ANSWER_MODEL=deepseek-ai/DeepSeek-V3
# ------------------------------------------------------------
# TOGETHER_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Any single node can override the provider, model or endpoint, e.g.
# ANSWER_PROVIDER=anthropic
# ANSWER_BASE_URL=https://other.gateway/v1

# ============================================================
# Throughput and limits
# ============================================================
MAX_RETRIES=3
# Client-side pacing. Leave unset unless the provider rate-limits you.
# REQUESTS_PER_SECOND=0.06
# Cap on generated tokens. On providers enforcing an output-tokens-per-minute
# ceiling this is a correctness setting, not only a cost control — an
# oversized request is rejected outright and cannot be retried.
# MAX_TOKENS=800

# ============================================================
# Research loop
# ============================================================
NUMBER_OF_INITIAL_QUERIES=2
MAX_RESEARCH_LOOPS=1
MAX_SEARCH_RESULTS=2

# ============================================================
# Observability
# ============================================================
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent-bcp
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
