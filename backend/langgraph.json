{
  "dependencies": [
    "."
  ],
  "graphs": {
    "research_agent": "./src/agents/research_agent/graph.py:graph"
  },
  "env": ".env",
  "python_version": "3.13",
  "api_version": "0.13.4",
  "dockerfile_lines": [
    "COPY pyproject.toml uv.lock /lock/",
    "RUN uv export --project /lock --frozen --no-dev --no-emit-project --no-hashes --output-file /lock/pins.txt",
    "RUN uv pip install --system --no-cache-dir -c /api/constraints.txt -r /lock/pins.txt"
  ],
  "auth": {
    "path": "./src/core/auth.py:auth"
  },
  "http": {
    "disable_assistants": true,
    "disable_store": true,
    "disable_ui": true,
    "disable_mcp": true,
    "disable_a2a": true,
    "disable_webhooks": true
  }
}
